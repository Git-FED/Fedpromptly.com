{
  "name": "web2apk",
  "version": "1.0.0",
  "description": "Wraps a website into an Android APK using Capacitor, built automatically via GitHub Actions.",
  "main": "electron/main.cjs",
  "scripts": {
    "sync": "npx cap sync android",
    "build:apk": "npx cap sync android && node scripts/run-gradle.mjs assembleDebug",
    "test": "node scripts/test.mjs",
    "dist": "electron-builder"
  },
  "keywords": [
    "capacitor",
    "android",
    "apk",
    "webview"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "extends": "./electron-builder.yml",
    "linux": {
      "maintainer": "FED Shell <support@example.com>",
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "homepage": "https://github.com/FED-OS/Build-Mobile-Apps-Android-iOS",
  "desktopName": "my-web-app"
}
